// Temp Pivot Tool installer for Maya.
// Drag and drop this file into Maya to install the tool and shelf button.

global proc string tempPivotInstall_GetScriptDir()
{
    string $info = `whatIs "tempPivotInstall_Run"`;
    string $path = $info;
    if (`gmatch $info "Mel procedure found in: *"`)
    {
        $path = substituteAllString($info, "Mel procedure found in: ", "");
    }
    else if (`gmatch $info "Script found in: *"`)
    {
        $path = substituteAllString($info, "Script found in: ", "");
    }

    $path = substituteAllString($path, "\\", "/");
    if ($path == $info || $path == "")
    {
        error "Temp Pivot Tool installer: unable to locate installer directory.";
    }
    return `dirname $path`;
}

global proc tempPivotInstall_CopyFile(string $source, string $destinationDir)
{
    string $cleanSource = substituteAllString($source, "\\", "/");
    string $targetDir = substituteAllString($destinationDir, "\\", "/");
    if (!`gmatch $targetDir "*/"`)
    {
        $targetDir += "/";
    }
    if (!`filetest -f $cleanSource`)
    {
        warning ("Temp Pivot Tool installer: missing file: " + $cleanSource);
        return;
    }
    if (!`filetest -d $targetDir`)
    {
        sysFile -makeDir $targetDir;
    }
    string $destination = ($targetDir + `basename $cleanSource ""`);
    sysFile -copy -force $cleanSource $destination;
}

global proc tempPivotInstall_CreateShelfButton(string $iconName)
{
    global string $gShelfTopLevel;
    string $currentShelf = `tabLayout -q -selectTab $gShelfTopLevel`;
    if ($currentShelf == "")
    {
        warning "Temp Pivot Tool installer: unable to locate current shelf.";
        return;
    }

    shelfButton -parent $currentShelf -label "Temp Pivot" -annotation "Temp Pivot Tool" -image $iconName -sourceType "python" -command "import temp_pivot_tool; temp_pivot_tool.show()";
}

global proc tempPivotInstall_Run()
{
    global string $gShelfTopLevel;
    string $scriptDir = tempPivotInstall_GetScriptDir();
    string $pythonSource = substituteAllString(($scriptDir + "/temp_pivot_tool.py"), "\\", "/");
    string $iconSource = substituteAllString(($scriptDir + "/temp-pivot.png"), "\\", "/");

    string $userScripts = substituteAllString(`internalVar -userScriptDir`, "\\", "/");
    string $userIcons = substituteAllString(`internalVar -userBitmapsDir`, "\\", "/");

    tempPivotInstall_CopyFile($pythonSource, $userScripts);
    tempPivotInstall_CopyFile($iconSource, $userIcons);

    tempPivotInstall_CreateShelfButton("temp-pivot.png");

    print ("Temp Pivot Tool installed. Shelf button added to: " + `tabLayout -q -selectTab $gShelfTopLevel` + "\n");
}

tempPivotInstall_Run();
